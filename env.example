# Скопируйте этот файл в .env и заполните значения.
# Токен никогда не вставляйте в HTML и не отправляйте в чат.
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# UUID баз данных без {{...}}.
PLAN_DATABASE_ID=
MAKINA_DATABASE_ID=
# Existing workspace task databases (defaults are already built into server.js)
TODO_DATABASE_ID=0ac3a96e-4687-4194-84cd-de563a12d85a
TODO_DATA_SOURCE_ID=b3d991ebc75b47ab8a88d2c723bc56db
GORULEN_ISLER_DATABASE_ID=02f39358-ebb4-4d32-b164-249f39ea2949
GORULEN_ISLER_DATA_SOURCE_ID=3136a23f839c40d3b6387de4d60af7f5


# Для новых баз Notion используйте data source IDs:
PLAN_DATA_SOURCE_ID=c8e9a1c9-d1fb-4d41-ad25-8bae79e48624
MAKINA_DATA_SOURCE_ID=18e01f9e-b1b4-462c-9043-41b579179797

# Названия свойств в базах задач.
TODO_MACHINE_RELATION_PROPERTY=Makina
TODO_TITLE_PROPERTY=Name
TODO_STATUS_PROPERTY=Proses
TODO_DUE_PROPERTY=Tarix
TODO_PRIORITY_PROPERTY=Prioritet
TODO_COMPLETE_PROPERTY=Status
TODO_ASSIGNEE_PROPERTY=Kime tapsirilib
TODO_TAPSIRILDI_PROPERTY=Tapsirildi
TODO_GTD_PROPERTY=GTD
TODO_GTD_VALUE=Check list
GORULEN_MACHINE_RELATION_PROPERTY=Makina
GORULEN_TITLE_PROPERTY=Gorulmeli isler
GORULEN_STATUS_PROPERTY=Proses
GORULEN_DATE_PROPERTY=Tarix
GORULEN_PRIORITY_PROPERTY=Prioritet
GORULEN_COMPLETE_PROPERTY=Status
GORULEN_ASSIGNEE_PROPERTY=Kime tapsirilib
GORULEN_TAPSIRILDI_PROPERTY=Tapsirildi
GORULEN_PERIODIC_PROPERTY=Is
GORULEN_PERIODIC_VALUE=Periodik

PORT=3000
CORS_ORIGIN=*
# Public HTTPS address used for deep links stored in Notion. On Railway set this to your generated domain.
PUBLIC_APP_URL=https://adib-production-eba3.up.railway.app
LINK_SYNC_TTL_MS=900000
NOTION_VERSION=2025-09-03

# New URL properties used for service deep links
TODO_LINK_PROPERTY=ADIB link
GORULEN_LINK_PROPERTY=ADIB link
MAKINA_LINK_PROPERTY=ADIB link

# Personal task manager
TASKS_DATABASE_ID=275e0789-d560-8063-8af3-efcbf4729097
TASKS_DATA_SOURCE_ID=

# Personal task manager persistence
PERSONAL_CONTAINERS_DATABASE_ID=73df6f96-1625-407d-89c2-02bc1c3b749c
PERSONAL_CONTAINERS_DATA_SOURCE_ID=78daa900-23f0-496d-a65a-864f8d63b0c5
# TASKS_DATABASE_ID is already configured above; TASKS_DATA_SOURCE_ID may remain empty.
